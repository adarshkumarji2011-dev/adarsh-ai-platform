{
  "name": "adarsh-ai-platform",
  "private": true,
  "version": "1.0.0",
  "description": "ADARSH AI — premium all-in-one AI platform (chat, images, voice, writing, coding, speaking practice).",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/",
    "typecheck": "echo \"javascript project - build performs the check\" && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "vite": "^5.4.14"
  }
}
